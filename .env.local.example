# Copy this file to .env.local for local dev, and add the same keys
# in Netlify: Site settings -> Environment variables (for production).

# Resend (https://resend.com) - free tier: 3,000 emails/mo, 100/day
RESEND_API_KEY=
# Must be on a domain you've verified in Resend, e.g. no-reply@boostupcleaningservices.au
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=contact@boostupcleaningservices.au

# Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile) - free, unlimited
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (https://upstash.com) - free tier: 10k commands/day
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Locks the API route to only accept requests from your own site
ALLOWED_ORIGIN=https://boostupcleaningservices.au
